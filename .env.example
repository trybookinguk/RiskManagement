# RiskManagement settings. Copy to /volume1/docker/RiskManagement/.env on the NAS,
# fill in, then: sudo chmod 600 /volume1/docker/RiskManagement/.env
# Never commit the real .env (it is in .gitignore).

# The "encrypt word": derives the hashing key for personal data and encrypts
# backups. Choose it ONCE and keep it in the password manager - it must never change.
RISK_ENCRYPTION_PASSPHRASE=

# S3 exports (read-only IAM user)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=produk-rdsextracts-438255373632

# Microsoft Graph: SharePoint + alert email (same app as s3reporting is fine)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SENDER_MAILBOX=
SHAREPOINT_DRIVE_ID=
SHAREPOINT_TRANSACTIONS_FOLDER=Platform Data/Booking Transactions

# Stripe restricted read-only key (Charges, PaymentIntents, Disputes, Reviews)
STRIPE_RESTRICTED_KEY=

# Behaviour
PAYMENT_RETENTION_DAYS=1100
ALERT_EMAIL=henry@trybooking.co.uk
# RISK_DB defaults to $RISK_DATA_DIR/risk.db (/data/risk.db in the containers)
