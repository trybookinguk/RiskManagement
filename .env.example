# RiskManagement settings. Copy to /volume1/docker/RiskManagement/.env on the NAS,
# fill in, then: sudo chmod 600 /volume1/docker/RiskManagement/.env
# Never commit the real .env (it is in .gitignore).

# The "encrypt word": derives the hashing key for personal data and encrypts
# backups. Choose it ONCE and keep it in the password manager - it must never change.
RISK_ENCRYPTION_PASSPHRASE=

# S3 exports (read-only IAM user)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=produk-rdsextracts-438255373632

# Microsoft Graph: SharePoint + alert email (same app as s3reporting is fine)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SENDER_MAILBOX=
SHAREPOINT_DRIVE_ID=
SHAREPOINT_TRANSACTIONS_FOLDER=Platform Data/Booking Transactions

# Stripe restricted read-only key (Charges, PaymentIntents, Disputes, Reviews)
STRIPE_RESTRICTED_KEY=

# Behaviour
PAYMENT_RETENTION_DAYS=1100
ALERT_EMAIL=henry@trybooking.co.uk
# Nightly risk report recipients (comma-separated)
REPORT_EMAIL=henry@trybooking.co.uk
# RISK_DB defaults to $RISK_DATA_DIR/risk.db (/data/risk.db in the containers)

# Dashboard + API (rmctl.sh web-start): Microsoft sign-in only, MFA required.
# Setup: docs/entra_sso_setup.md. AZURE_TENANT_ID above is the tenant users must be in.
WEB_PORT=8085
WEB_ENTRA_CLIENT_ID=
WEB_ENTRA_CLIENT_SECRET=
WEB_BASE_URL=https://trybooking.synology.me:8443
WEB_ALLOWED_DOMAINS=trybooking.co.uk
# How the app double-checks MFA: amr_or_acrs (default) | amr | acrs | off (Conditional Access only)
WEB_MFA_CHECK=amr_or_acrs
# Conditional Access authentication context that requires MFA (docs/entra_sso_setup.md step 3a)
WEB_AUTH_CONTEXT=c1

# TEMPORARY remote access via ngrok (docs/ngrok_temporary.md); leave empty when not used.
# While it's in use, WEB_BASE_URL must be https://<NGROK_DOMAIN>.
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
